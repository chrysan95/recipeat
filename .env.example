FLASK_APP=wsgi.py
FLASK_DEBUG=1
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
# Local: docker compose. Production (Vercel): Neon pooled connection string (…-pooler…?sslmode=require)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recipeat
BCRYPT_ROUNDS=12
# Local: docker compose. Production (Vercel): Upstash URL (rediss://default:…@….upstash.io:6379)
REDIS_URL=redis://localhost:6379/0
